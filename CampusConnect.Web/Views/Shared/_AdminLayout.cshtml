@using Microsoft.AspNetCore.Identity
@inject SignInManager<CampusConnect.Web.Models.ApplicationUser> SignInManager

@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var navItems = new[] {
        new { Action = "Dashboard", Label = "Overview", Icon = "bi-speedometer2" },
        new { Action = "Marketplace", Label = "Marketplace", Icon = "bi-bag" },
        new { Action = "Accommodation", Label = "Accommodation", Icon = "bi-building" },
        new { Action = "Services", Label = "Services", Icon = "bi-wrench" },
        new { Action = "Users", Label = "Users", Icon = "bi-people" },
        new { Action = "Reports", Label = "Reports", Icon = "bi-flag" },
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background:var(--neutral-50);">
    <div style="min-height:100vh;display:flex;">
        <!-- Sidebar -->
        <aside class="cc-admin-sidebar">
            <div class="cc-admin-sidebar-header">
                <div class="cc-admin-sidebar-logo">
                    <i class="bi bi-shield-lock" style="color:#fff;font-size:18px;"></i>
                </div>
                <span style="font-family:var(--font-head);font-size:18px;font-weight:700;color:#fff;">Admin Panel</span>
            </div>
            <nav style="flex:1;padding:16px 12px;display:flex;flex-direction:column;gap:4px;">
                @foreach (var item in navItems)
                {
                    <a href="/Admin/@item.Action" class="cc-admin-nav-link @(currentAction == item.Action ? "active" : "")">
                        <i class="@item.Icon"></i>
                        @item.Label
                    </a>
                }
            </nav>
            <div style="padding:16px;border-top:1px solid var(--neutral-800);">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
                    <div style="width:36px;height:36px;border-radius:50%;background:var(--primary-700);display:flex;align-items:center;justify-content:center;font-weight:600;color:#fff;">
                        A
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:600;color:#fff;">Admin</div>
                        <div style="font-size:11px;color:var(--neutral-500);">Administrator</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;font-size:13px;color:var(--neutral-400);cursor:pointer;border:1px solid var(--neutral-700);background:transparent;width:100%;">
                        <i class="bi bi-box-arrow-right"></i>
                        Log out
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main content -->
        <div style="flex:1;min-width:0;display:flex;flex-direction:column;">
            <main style="flex:1;padding:32px;overflow-y:auto;">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
