@using Microsoft.AspNetCore.Identity
@inject SignInManager<CampusConnect.Web.Models.ApplicationUser> SignInManager

@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var navItems = new[] {
        new { Action = "Dashboard", Controller = "Home", Label = "Dashboard", Icon = "bi-house-door" },
        new { Action = "Index", Controller = "Marketplace", Label = "Marketplace", Icon = "bi-bag" },
        new { Action = "Index", Controller = "Accommodation", Label = "Accommodation", Icon = "bi-building" },
        new { Action = "Index", Controller = "Service", Label = "Services", Icon = "bi-wrench" },
        new { Action = "Index", Controller = "Messages", Label = "Messages", Icon = "bi-chat-dots" },
        new { Action = "Index", Controller = "Favourites", Label = "Saved", Icon = "bi-heart" },
        new { Action = "Index", Controller = "Profile", Label = "Profile", Icon = "bi-person" },
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusConnect</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background:var(--neutral-50);">
    <div style="min-height:100vh;display:flex;flex-direction:column;">
        <!-- Top bar -->
        <header class="cc-topbar">
            <div class="cc-topbar-inner">
                <div style="display:flex;align-items:center;gap:32px;">
                    <a href="/" class="cc-logo">Campus<span>Connect</span></a>
                    <nav style="display:flex;gap:4px;flex-wrap:wrap;">
                        @foreach (var item in navItems)
                        {
                            var isActive = currentController == item.Controller;
                            <a href="/@item.Controller@(item.Action == "Index" ? "" : "/" + item.Action)"
                               class="cc-nav-link @(isActive ? "active" : "")">
                                <i class="@item.Icon"></i>
                                @item.Label
                            </a>
                        }
                    </nav>
                </div>
                <div style="display:flex;align-items:center;gap:16px;">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div style="display:flex;align-items:center;gap:10px;">
                            <div style="width:36px;height:36px;border-radius:50%;background:var(--primary-100);display:flex;align-items:center;justify-content:center;font-weight:600;color:var(--primary-700);">
                                @(User.Identity?.Name?.Substring(0,1).ToUpper())
                            </div>
                            <div style="display:flex;flex-direction:column;">
                                <span style="font-size:13px;font-weight:600;color:var(--neutral-800);">@User.Identity?.Name</span>
                                <span style="font-size:11px;color:var(--neutral-500);">Student</span>
                            </div>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" title="Log out" style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:8px;color:var(--neutral-500);cursor:pointer;border:1px solid var(--neutral-200);background:transparent;">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login" class="cc-nav-link">Log in</a>
                        <a href="/Account/Register" class="btn btn-primary btn-md">Sign up free</a>
                    }
                </div>
            </div>
        </header>

        <!-- Main content -->
        <main style="flex:1;max-width:1280px;margin:0 auto;padding:32px 24px;width:100%;">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="cc-footer">
            <div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:8px;">
                <i class="bi bi-shield-check" style="color:var(--accent-400);"></i>
                <span>CampusConnect - Verified students only. All transactions are peer-to-peer.</span>
            </div>
            <span>&copy; 2025 CampusConnect. A student-built platform for INSY 7315.</span>
        </footer>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
