@model CampusConnect.Web.Models.Accommodation

@{
    ViewData["Title"] = "Post accommodation";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <h1 style="font-size:26px;margin-bottom:4px;">Post accommodation</h1>
        <p style="font-size:14px;color:var(--neutral-500);margin-bottom:28px;">List your room, flat, or house for other students to find.</p>

        @if (TempData["Success"] != null)
        {
            <div style="padding:12px 16px;border-radius:var(--radius-md);background:var(--accent-50);color:var(--accent-700);font-size:14px;margin-bottom:20px;display:flex;align-items:center;gap:8px;">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
            </div>
        }

        <div style="padding:28px;border-radius:var(--radius-lg);background:var(--neutral-0);border:1px solid var(--neutral-100);box-shadow:var(--shadow-sm);">
            <form asp-action="Create" asp-controller="Accommodation" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label class="cc-form-label">Title</label>
                    <input asp-for="Title" class="cc-form-control" placeholder="e.g. Modern Studio Near Campus" />
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="cc-form-label">Type</label>
                        <select asp-for="Type" class="cc-form-control">
                            <option>Studio</option>
                            <option>Flat</option>
                            <option>House</option>
                            <option>Cottage</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="cc-form-label">Rent per month (R)</label>
                        <input asp-for="RentPerMonth" class="cc-form-control" type="number" placeholder="4500" />
                    </div>
                </div>
                <div class="row g-3 mt-0">
                    <div class="col-md-6">
                        <label class="cc-form-label">Location</label>
                        <input asp-for="Location" class="cc-form-control" placeholder="Rondebosch" />
                    </div>
                    <div class="col-md-3">
                        <label class="cc-form-label">Bedrooms</label>
                        <input asp-for="Bedrooms" class="cc-form-control" type="number" value="1" />
                    </div>
                    <div class="col-md-3">
                        <label class="cc-form-label">Bathrooms</label>
                        <input asp-for="Bathrooms" class="cc-form-control" type="number" value="1" />
                    </div>
                </div>
                <div class="mb-3 mt-3">
                    <label class="cc-form-label">Description</label>
                    <textarea asp-for="Description" class="cc-form-control" rows="4" placeholder="Describe the accommodation..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-check" style="font-size:14px;color:var(--neutral-600);display:flex;align-items:center;gap:8px;">
                        <input asp-for="IsFurnished" type="checkbox" /> Furnished
                    </label>
                </div>
                <div class="mb-3">
                    <label class="cc-form-label">Contact email</label>
                    <input asp-for="ContactEmail" class="cc-form-control" placeholder="name@university.edu" />
                </div>
                <div class="mb-3">
                    <label class="cc-form-label">Upload image</label>
                    <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" class="form-control" />
                    <small class="text-muted">JPG, PNG, WebP or GIF. Max 5MB.</small>
                </div>
                <div style="display:flex;gap:12px;">
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1">Post accommodation</button>
                    <a href="/Accommodation" class="btn btn-ghost btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
