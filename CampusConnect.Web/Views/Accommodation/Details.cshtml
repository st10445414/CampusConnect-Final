@model CampusConnect.Web.Models.Accommodation
@using Microsoft.AspNetCore.Identity
@using CampusConnect.Web.Models
@inject UserManager<ApplicationUser> _userManager

@{
    ViewData["Title"] = Model.Title;
}

<div class="row g-4">
    <div class="col-md-6">
        <div style="height:300px;border-radius:var(--radius-lg);background:linear-gradient(135deg,var(--neutral-100),var(--neutral-200));display:flex;align-items:center;justify-content:center;color:var(--neutral-400);font-size:16px;">
            <i class="bi bi-building" style="font-size:48px;"></i>
        </div>
    </div>
    <div class="col-md-6">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;">
            <div>
                <h1 style="font-size:24px;margin-bottom:8px;">@Model.Title</h1>
                <span style="font-size:13px;padding:3px 10px;border-radius:6px;background:var(--neutral-100);color:var(--neutral-600);">@Model.Type</span>
            </div>
            <span style="font-size:28px;font-weight:700;color:var(--primary-700);">R@(Model.RentPerMonth)<span style="font-size:14px;font-weight:400;">/mo</span></span>
        </div>
        <div style="font-size:13px;color:var(--neutral-500);margin-bottom:16px;display:flex;align-items:center;gap:4px;">
            <i class="bi bi-geo-alt" style="font-size:13px;"></i> @Model.Location
        </div>
        <div style="display:flex;gap:20px;margin-bottom:16px;">
            <div style="text-align:center;padding:12px 20px;border-radius:var(--radius-md);background:var(--neutral-50);">
                <div style="font-size:20px;font-weight:700;color:var(--neutral-900);">@Model.Bedrooms</div>
                <div style="font-size:12px;color:var(--neutral-500);">Bedrooms</div>
            </div>
            <div style="text-align:center;padding:12px 20px;border-radius:var(--radius-md);background:var(--neutral-50);">
                <div style="font-size:20px;font-weight:700;color:var(--neutral-900);">@Model.Bathrooms</div>
                <div style="font-size:12px;color:var(--neutral-500);">Bathrooms</div>
            </div>
            <div style="text-align:center;padding:12px 20px;border-radius:var(--radius-md);background:var(--neutral-50);">
                <div style="font-size:20px;font-weight:700;color:var(--neutral-900);">@(Model.IsFurnished ? "Yes" : "No")</div>
                <div style="font-size:12px;color:var(--neutral-500);">Furnished</div>
            </div>
        </div>
        <hr style="border-color:var(--neutral-100);" />
        <p style="font-size:14px;color:var(--neutral-600);line-height:1.6;margin-bottom:24px;">@Model.Description</p>
        <div style="font-size:13px;color:var(--neutral-500);margin-bottom:20px;">
            <i class="bi bi-calendar"></i> Available from: @Model.AvailableFrom.ToString("yyyy-MM-dd")
        </div>
        <div style="display:flex;gap:12px;">
            @if (Model.PostedById != _userManager.GetUserId(User))
            {
                <form asp-action="StartConversation" asp-controller="Messages" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="recipientId" value="@Model.PostedById" />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-chat-dots"></i> Contact poster</button>
                </form>
            }
            @if (Model.PostedById == _userManager.GetUserId(User))
            {
                <form asp-controller="Accommodation" asp-action="Delete" asp-route-id="@Model.AccommodationId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Remove this listing?')"><i class="bi bi-trash"></i> Remove</button>
                </form>
            }
        </div>
    </div>
</div>
