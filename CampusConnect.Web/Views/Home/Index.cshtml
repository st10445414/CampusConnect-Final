@{
    ViewData["Title"] = "CampusConnect - Connect. Share. Succeed.";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background:var(--neutral-50);">
    <!-- Nav -->
    <nav class="cc-landing-nav">
        <div class="cc-landing-nav-inner">
            <a href="/" class="cc-logo">Campus<span>Connect</span></a>
            <div style="display:flex;align-items:center;gap:12px;">
                <a href="/Account/Login" style="font-size:14px;font-weight:600;color:var(--neutral-700);">Log in</a>
                <a href="/Account/Register" class="btn btn-primary btn-md">Sign up free</a>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="cc-hero">
        <div class="cc-hero-badge">
            <span style="width:8px;height:8px;border-radius:50%;background:var(--accent-400);"></span>
            Built by students, for students
        </div>
        <h1>
            Everything your campus needs,<br />
            <span style="color:var(--primary-700);">in one place.</span>
        </h1>
        <p>
            CampusConnect is a verified student-only platform for buying, selling,
            finding accommodation, and discovering services within your university community.
        </p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
            <a href="/Account/Register" class="btn btn-primary btn-lg">Get started <i class="bi bi-arrow-right"></i></a>
            <a href="/Account/Login" class="btn btn-outline-primary btn-lg">Log in</a>
        </div>

        <!-- Hero mockup -->
        <div class="cc-hero-mockup">
            <div class="cc-hero-mockup-header">
                <div style="max-width:600px;margin:0 auto;text-align:center;">
                    <div style="display:inline-flex;align-items:center;gap:8px;padding:8px 20px;border-radius:100px;background:rgba(255,255,255,0.15);font-size:14px;font-weight:600;margin-bottom:20px;">
                        <i class="bi bi-people"></i> Welcome back, Aisha
                    </div>
                    <h2 style="color:#fff;font-size:28px;margin-bottom:8px;">Your campus hub</h2>
                    <p style="color:rgba(255,255,255,0.85);font-size:15px;">3 new listings in your faculty &middot; 2 accommodation matches &middot; 1 service recommendation</p>
                </div>
            </div>
            <div class="cc-hero-mockup-grid">
                @{
                    var mockupCards = new[] {
                        new { Icon = "bi-bag", Label = "Marketplace", Val = "340 listings", Color = "var(--primary-700)", Bg = "var(--primary-50)" },
                        new { Icon = "bi-building", Label = "Accommodation", Val = "12 available", Color = "var(--accent-600)", Bg = "var(--accent-50)" },
                        new { Icon = "bi-wrench", Label = "Services", Val = "85 providers", Color = "var(--warning-600)", Bg = "var(--warning-50)" },
                        new { Icon = "bi-heart", Label = "Saved items", Val = "7 saved", Color = "var(--error-500)", Bg = "var(--error-50)" },
                    };
                }
                @foreach (var card in mockupCards)
                {
                    <div class="cc-hero-mockup-card">
                        <div style="width:40px;height:40px;border-radius:10px;background:@card.Color;display:flex;align-items:center;justify-content:center;margin-bottom:12px;">
                            <i class="@card.Icon" style="color:#fff;font-size:18px;"></i>
                        </div>
                        <div style="font-size:13px;color:var(--neutral-500);margin-bottom:4px;">@card.Label</div>
                        <div style="font-size:18px;font-weight:700;color:var(--neutral-900);">@card.Val</div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Stats -->
    <section class="cc-stats-bar">
        <div class="cc-stats-bar-inner">
            @{
                var stats = new[] {
                    new { Value = "1,200+", Label = "Active students" },
                    new { Value = "340", Label = "Listings live" },
                    new { Value = "85", Label = "Services offered" },
                    new { Value = "4.8★", Label = "Average rating" },
                };
            }
            @foreach (var s in stats)
            {
                <div>
                    <div class="cc-stat-bar-value">@s.Value</div>
                    <div class="cc-stat-bar-label">@s.Label</div>
                </div>
            }
        </div>
    </section>

    <!-- Features -->
    <section class="cc-features-section">
        <div style="text-align:center;margin-bottom:48px;">
            <h2 style="font-size:32px;margin-bottom:12px;">Why students choose CampusConnect</h2>
            <p style="font-size:16px;color:var(--neutral-600);max-width:500px;margin:0 auto;">
                Four core features designed around the real needs of university life.
            </p>
        </div>
        <div class="row g-4">
            @{
                var features = new[] {
                    new { Icon = "bi-bag", Title = "Marketplace", Desc = "Buy and sell textbooks, electronics, furniture, and more with fellow students." },
                    new { Icon = "bi-building", Title = "Accommodation", Desc = "Find rooms, flats, and house shares near campus from trusted student landlords." },
                    new { Icon = "bi-wrench", Title = "Services", Desc = "Tutoring, repairs, haircuts, and more - offered by students, for students." },
                    new { Icon = "bi-shield-check", Title = "Verified & Safe", Desc = "Every member is verified with a university email. Report and block system built in." },
                };
            }
            @foreach (var f in features)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="cc-feature-card">
                        <div class="cc-feature-icon">
                            <i class="@f.Icon" style="color:var(--primary-700);font-size:24px;"></i>
                        </div>
                        <h3 style="font-size:18px;margin-bottom:8px;">@f.Title</h3>
                        <p style="font-size:14px;color:var(--neutral-600);line-height:1.6;">@f.Desc</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- How it works -->
    <section class="cc-howitworks-section">
        <div class="cc-howitworks-inner">
            <div style="text-align:center;margin-bottom:48px;">
                <h2 style="font-size:32px;margin-bottom:12px;">How it works</h2>
            </div>
            <div class="row g-4">
                @{
                    var steps = new[] {
                        new { Num = "01", Title = "Sign up with your university email", Desc = "We verify every member so you know you are dealing with real students." },
                        new { Num = "02", Title = "Browse or post listings", Desc = "List items for sale, search for accommodation, or offer your skills as a service." },
                        new { Num = "03", Title = "Connect and transact", Desc = "Message sellers, save favourites, and arrange to meet on campus safely." },
                    };
                }
                @foreach (var step in steps)
                {
                    <div class="col-md-4">
                        <div class="cc-step-num">@step.Num</div>
                        <h3 style="font-size:18px;margin-bottom:8px;">@step.Title</h3>
                        <p style="font-size:14px;color:var(--neutral-600);line-height:1.6;">@step.Desc</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cc-cta-section">
        <div class="cc-cta-banner">
            <i class="bi bi-graph-up-arrow" style="font-size:40px;margin-bottom:16px;"></i>
            <h2 style="color:#fff;font-size:32px;margin-bottom:12px;">Ready to join your campus community?</h2>
            <p style="color:rgba(255,255,255,0.85);font-size:16px;margin-bottom:32px;max-width:450px;margin-left:auto;margin-right:auto;">
                It is free to join. Sign up with your university email and start connecting today.
            </p>
            <a href="/Account/Register" class="btn btn-secondary btn-lg">Create your account <i class="bi bi-arrow-right"></i></a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="cc-landing-footer">
        <a href="/" class="cc-logo" style="font-size:18px;">Campus<span>Connect</span></a>
        <p style="margin-top:16px;font-size:13px;">&copy; 2025 CampusConnect. A student-built platform for INSY 7315.</p>
        <div style="margin-top:8px;display:flex;gap:16px;justify-content:center;font-size:13px;">
            <span>Verified students only</span>
            <span>&middot;</span>
            <span>Peer-to-peer marketplace</span>
            <span>&middot;</span>
            <span>Safe & moderated</span>
        </div>
    </footer>
</body>
</html>
