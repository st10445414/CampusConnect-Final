@model CampusConnect.Web.Controllers.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="text-center mb-3"><i class="bi bi-key"></i> Forgot Password</h3>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-info">@ViewBag.Message</div>

                    @if (ViewBag.ResetLink != null)
                    {
                        <div class="alert alert-warning">
                            <strong>Development mode:</strong> No email server is configured.
                            <a href="@ViewBag.ResetLink" class="alert-link">Click here to reset your password</a>.
                        </div>
                    }
                    <div class="text-center mt-3">
                        <a href="@Url.Action("Login")" class="btn btn-outline-primary">Back to login</a>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center mb-4">Enter your university email and we'll send you a link to reset your password.</p>

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="name@university.edu" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send reset link</button>
                    </form>
                    <div class="text-center mt-3">
                        <a href="@Url.Action("Login")" class="text-decoration-none">Back to login</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
