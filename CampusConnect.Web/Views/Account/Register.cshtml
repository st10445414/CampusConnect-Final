@model CampusConnect.Web.Controllers.RegisterViewModel

@{
    ViewData["Title"] = "Create your account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusConnect</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="cc-auth-wrapper">
        <!-- Gradient side (left) -->
        <div class="cc-auth-gradient-side cc-auth-gradient-register">
            <div style="position:relative;z-index:1;max-width:420px;color:#fff;">
                <i class="bi bi-mortarboard" style="font-size:48px;margin-bottom:24px;"></i>
                <h2 style="color:#fff;font-size:28px;margin-bottom:16px;line-height:1.2;">Join 1,200+ students already connected.</h2>
                <p style="color:rgba(255,255,255,0.85);font-size:16px;line-height:1.6;margin-bottom:32px;">
                    Create your free account and start buying, selling, and connecting with your campus community.
                </p>
                <div style="display:flex;flex-direction:column;gap:12px;">
                    @foreach (var item in new[] { "Free to join - no subscription, no fees", "Post unlimited listings", "Access verified accommodation and services" })
                    {
                        <div style="display:flex;align-items:center;gap:10px;">
                            <i class="bi bi-check-circle" style="color:var(--accent-400);font-size:20px;"></i>
                            <span style="color:rgba(255,255,255,0.9);font-size:14px;">@item</span>
                        </div>
                    }
                </div>
            </div>
            <div class="cc-auth-decorative-circle" style="top:-60px;left:-60px;width:200px;height:200px;"></div>
            <div class="cc-auth-decorative-circle" style="bottom:-80px;right:-80px;width:280px;height:280px;"></div>
        </div>

        <!-- Form side (right) -->
        <div class="cc-auth-form-side">
            <div class="cc-auth-form-inner">
                <a href="/" class="cc-logo">Campus<span>Connect</span></a>
                <h1 style="font-size:28px;margin-top:32px;margin-bottom:8px;">Create your account</h1>
                <p style="font-size:15px;color:var(--neutral-500);margin-bottom:32px;">
                    Sign up with your university email to get verified.
                </p>

                <form asp-action="Register" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="cc-form-label">Full name</label>
                        <div style="position:relative;">
                            <i class="bi bi-person" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--neutral-400);"></i>
                            <input asp-for="FullName" class="cc-form-control" style="padding-left:42px;" placeholder="Aisha Patel" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="cc-form-label">University email</label>
                        <div style="position:relative;">
                            <i class="bi bi-envelope" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--neutral-400);"></i>
                            <input asp-for="Email" class="cc-form-control" style="padding-left:42px;" placeholder="name@university.edu" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="cc-form-label">Password</label>
                        <div style="position:relative;">
                            <i class="bi bi-lock" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--neutral-400);"></i>
                            <input asp-for="Password" class="cc-form-control" style="padding-left:42px;" type="password" placeholder="At least 8 characters" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Faculty" class="cc-form-label">Faculty</label>
                        <select asp-for="Faculty" class="cc-form-control">
                            <option value="">Select your faculty...</option>
                            <option>Faculty of Engineering</option>
                            <option>Faculty of Science</option>
                            <option>Faculty of Commerce</option>
                            <option>Faculty of Humanities</option>
                            <option>Faculty of Health Sciences</option>
                            <option>Faculty of Law</option>
                        </select>
                        <span asp-validation-for="Faculty" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="YearOfStudy" class="cc-form-label">Year of study</label>
                        <select asp-for="YearOfStudy" class="cc-form-control">
                            <option value="">Select year...</option>
                            <option>1st Year</option>
                            <option>2nd Year</option>
                            <option>3rd Year</option>
                            <option>4th Year / Honours</option>
                            <option>Postgraduate</option>
                        </select>
                        <span asp-validation-for="YearOfStudy" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Create account <i class="bi bi-arrow-right"></i></button>
                </form>

                <p style="text-align:center;margin-top:24px;font-size:14px;color:var(--neutral-500);">
                    Already have an account? <a href="/Account/Login" style="color:var(--primary-700);font-weight:600;">Log in</a>
                </p>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
