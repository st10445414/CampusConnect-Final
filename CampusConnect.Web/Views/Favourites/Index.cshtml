@model IEnumerable<CampusConnect.Web.Models.Favourite>

@{
    ViewData["Title"] = "Saved Items";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-heart-fill text-danger"></i> Saved Items</h2>
            <p class="text-muted">Listings you've saved for later.</p>
        </div>
        <a href="@Url.Action("Index", "Marketplace")" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Back to Marketplace
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-heart" style="font-size: 3rem; color: #ccc;"></i>
            <h4 class="mt-3 text-muted">No saved items yet</h4>
            <p class="text-muted">Tap the heart icon on any listing to save it here.</p>
            <a href="@Url.Action("Index", "Marketplace")" class="btn btn-primary mt-2">Browse marketplace</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var fav in Model)
            {
                var listing = fav.Listing;
                if (listing == null) continue;
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm listing-card">
                        @if (listing.Images.Any())
                        {
                            <img src="@listing.Images.First().Url" class="card-img-top" alt="@listing.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-image" style="font-size: 2.5rem; color: #ccc;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <span class="badge @GetStatusBadge(listing.Status) mb-2">@listing.Status</span>
                            <h5 class="card-title">@listing.Title</h5>
                            <p class="card-text text-muted small">@listing.Category &middot; @listing.Condition</p>
                            <p class="card-text"><span class="fw-bold text-primary">R@(listing.Price)</span></p>
                            <p class="card-text small text-muted"><i class="bi bi-geo-alt"></i> @listing.Location</p>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 d-flex gap-2">
                            <a href="@Url.Action("Details", "Marketplace", new { id = listing.ListingId })" class="btn btn-sm btn-outline-primary flex-grow-1">
                                View details
                            </a>
                            <form method="post" action="@Url.Action("Remove", "Favourites", new { favouriteId = fav.FavouriteId })">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove from saved">
                                    <i class="bi bi-heart-fill"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    string GetStatusBadge(CampusConnect.Web.Models.ListingStatus status)
    {
        return status switch
        {
            CampusConnect.Web.Models.ListingStatus.Available => "bg-success",
            CampusConnect.Web.Models.ListingStatus.PendingSale => "bg-warning",
            CampusConnect.Web.Models.ListingStatus.Sold => "bg-secondary",
            CampusConnect.Web.Models.ListingStatus.PendingReview => "bg-info",
            _ => "bg-light text-dark"
        };
    }
}
