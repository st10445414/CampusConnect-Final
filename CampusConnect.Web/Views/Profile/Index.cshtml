@model CampusConnect.Web.Models.ApplicationUser
@using CampusConnect.Web.Models

@{
    ViewData["Title"] = "Profile";
    var listings = ViewBag.Listings as IEnumerable<Listing> ?? Enumerable.Empty<Listing>();
    var services = ViewBag.Services as IEnumerable<Service> ?? Enumerable.Empty<Service>();
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
    <div>
        <h1 style="font-size:26px;margin-bottom:4px;">My Profile</h1>
        <p style="font-size:14px;color:var(--neutral-500);">Manage your account and listings.</p>
    </div>
    <a href="/Profile/Edit" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit profile</a>
</div>

@if (TempData["Success"] != null)
{
    <div style="padding:12px 16px;border-radius:var(--radius-md);background:var(--accent-50);color:var(--accent-700);font-size:14px;margin-bottom:20px;display:flex;align-items:center;gap:8px;">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
    </div>
}

<div style="padding:28px;border-radius:var(--radius-lg);background:var(--neutral-0);border:1px solid var(--neutral-100);box-shadow:var(--shadow-sm);margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;">
        <div style="width:64px;height:64px;border-radius:50%;background:var(--primary-100);display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;color:var(--primary-700);">
            @(Model.FullName?.Substring(0,1).ToUpper() ?? "S")
        </div>
        <div>
            <h2 style="font-size:20px;margin-bottom:4px;">@Model.FullName</h2>
            <div style="font-size:14px;color:var(--neutral-500);">@Model.Email</div>
            <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
                @foreach (var role in roles)
                {
                    <span class="cc-badge cc-badge-neutral">@role</span>
                }
                @if (Model.IsVerified)
                {
                    <span class="cc-badge cc-badge-available"><i class="bi bi-patch-check"></i> Verified</span>
                }
            </div>
        </div>
    </div>
    <div style="display:flex;gap:32px;margin-top:20px;flex-wrap:wrap;">
        <div>
            <div style="font-size:13px;color:var(--neutral-500);">Faculty</div>
            <div style="font-size:15px;font-weight:600;">@Model.Faculty</div>
        </div>
        <div>
            <div style="font-size:13px;color:var(--neutral-500);">Year of study</div>
            <div style="font-size:15px;font-weight:600;">@Model.YearOfStudy</div>
        </div>
        <div>
            <div style="font-size:13px;color:var(--neutral-500);">Joined</div>
            <div style="font-size:15px;font-weight:600;">@Model.JoinedDate.ToString("yyyy-MM-dd")</div>
        </div>
    </div>
</div>

<h3 style="font-size:18px;margin-bottom:16px;">My marketplace listings</h3>
<div class="row g-3 mb-4">
    @foreach (var listing in listings)
    {
        <div class="col-md-6 col-lg-4">
            <a href="/Marketplace/Details/@listing.ListingId" style="text-decoration:none;">
                <div class="cc-listing-card" style="padding:16px;">
                    <div style="font-size:14px;font-weight:600;color:var(--neutral-900);margin-bottom:4px;">@listing.Title</div>
                    <div style="font-size:13px;color:var(--neutral-500);">R@(listing.Price) &middot; @listing.Status</div>
                </div>
            </a>
        </div>
    }
    @if (!listings.Any())
    {
        <div style="color:var(--neutral-500);font-size:14px;padding:20px 0;">You have not posted any listings yet. <a href="/Marketplace/Create" style="color:var(--primary-700);font-weight:600;">Post one now</a>.</div>
    }
</div>

<h3 style="font-size:18px;margin-bottom:16px;">My services</h3>
<div class="row g-3">
    @foreach (var service in services)
    {
        <div class="col-md-6 col-lg-4">
            <a href="/Service/Details/@service.ServiceId" style="text-decoration:none;">
                <div class="cc-listing-card" style="padding:16px;">
                    <div style="font-size:14px;font-weight:600;color:var(--neutral-900);margin-bottom:4px;">@service.Title</div>
                    <div style="font-size:13px;color:var(--neutral-500);">@service.Price &middot; @service.Category</div>
                </div>
            </a>
        </div>
    }
    @if (!services.Any())
    {
        <div style="color:var(--neutral-500);font-size:14px;padding:20px 0;">You have not posted any services yet. <a href="/Service/Create" style="color:var(--primary-700);font-weight:600;">Offer one now</a>.</div>
    }
</div>
