@model IEnumerable<CampusConnect.Web.Models.Conversation>

@{
    ViewData["Title"] = "Messages";
    var currentUserId = _userManager.GetUserId(User);
}

@inject Microsoft.AspNetCore.Identity.UserManager<CampusConnect.Web.Models.ApplicationUser> _userManager

<div class="container mt-4">
    <div class="mb-4">
        <h2><i class="bi bi-chat-dots"></i> Messages</h2>
        <p class="text-muted">Your conversations with other students.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-chat" style="font-size: 3rem; color: #ccc;"></i>
            <h4 class="mt-3 text-muted">No conversations yet</h4>
            <p class="text-muted">Visit a listing and message the seller to start chatting.</p>
            <a href="@Url.Action("Index", "Marketplace")" class="btn btn-primary mt-2">Browse marketplace</a>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var convo in Model)
            {
                var otherUser = convo.User1Id == currentUserId ? convo.User2 : convo.User1;
                var lastMessage = convo.Messages.OrderByDescending(m => m.SentAt).FirstOrDefault();
                var unreadCount = convo.Messages.Count(m => m.SenderId != currentUserId && !m.IsRead);
                var initial = !string.IsNullOrEmpty(otherUser?.FullName) ? otherUser.FullName[0].ToString() : "?";

                <a href="@Url.Action("Conversation", "Messages", new { id = convo.ConversationId })"
                   class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px; font-weight: 600; flex-shrink: 0;">
                        @initial
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>@otherUser?.FullName</strong>
                            @if (lastMessage != null)
                            {
                                <small class="text-muted">@lastMessage.SentAt.ToString("dd MMM, HH:mm")</small>
                            }
                        </div>
                        <p class="text-muted mb-0 text-truncate">
                            @(lastMessage != null ? (lastMessage.SenderId == currentUserId ? "You: " : "") + lastMessage.Content : "No messages yet")
                        </p>
                    </div>
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill">@unreadCount</span>
                    }
                </a>
            }
        </div>
    }
</div>
